diff --git a/csrc/bindings.cpp b/csrc/bindings.cpp
index fa44fdc..162f4b9 100644
--- a/csrc/bindings.cpp
+++ b/csrc/bindings.cpp
@@ -391,4 +391,37 @@ PYBIND11_MODULE(pyeas, m) {
   register_types<CornerDhState>(m, "CornerDh");
   register_types<PtttState<false>>(m, "Pttt");
   register_types<PtttState<true>>(m, "AbruptPttt");
+  register_types<CornerAbruptPtttState>(m, "CornerAbruptPttt");
+
+  m.def(
+      "set_pttt_opening",
+      [](const std::vector<int> &p0, const std::vector<int> &p1, bool masked) {
+        if (p0.size() != p1.size() || p0.empty() || p0.size() > 2)
+          throw std::invalid_argument("give 1 or 2 cells per player, the same number each");
+        bool used[9] = {false};
+        for (const auto *cells : {&p0, &p1})
+          for (int c : *cells) {
+            if (c < 0 || c > 8 || used[c])
+              throw std::invalid_argument("cells must be distinct and in 0..8");
+            used[c] = true;
+          }
+        PtttOpening o;
+        o.n = uint8_t(p0.size());
+        for (size_t k = 0; k < p0.size(); ++k) {
+          o.cells[0][k] = uint8_t(p0[k]);
+          o.cells[1][k] = uint8_t(p1[k]);
+        }
+        o.masked = masked;
+        g_pttt_opening = o;
+      },
+      py::arg("p0_cells"), py::arg("p1_cells"), py::arg("masked") = true);
+  m.def("get_pttt_opening", []() {
+    const PtttOpening &o = g_pttt_opening;
+    std::vector<int> p0, p1;
+    for (uint8_t k = 0; k < o.n; ++k) {
+      p0.push_back(o.cells[0][k]);
+      p1.push_back(o.cells[1][k]);
+    }
+    return py::make_tuple(p0, p1, o.masked);
+  });
 }
