diff --git a/csrc/pttt_state.h b/csrc/pttt_state.h
index 8e09a43..18b58da 100644
--- a/csrc/pttt_state.h
+++ b/csrc/pttt_state.h
@@ -105,3 +105,41 @@ struct PtttState : public BaseState<abrupt> {
     }
   }
 };
+
+// Abrupt PTTT with a fixed, commonly known opening, as CornerDh does for Dark
+// Hex: each player's first n moves (n = 1 or 2) are pre-placed, all successful,
+// in the order P0, P1, P0, P1. If masked, a player may not probe a cell the
+// opponent holds from the opening. The opening is read when a state is
+// constructed, so set it with set_pttt_opening() before building a traverser,
+// and use one opening per process.
+struct PtttOpening {
+  uint8_t n = 1;
+  uint8_t cells[2][2] = {{4, 2}, {0, 8}};
+  bool masked = true;
+};
+inline PtttOpening g_pttt_opening;
+
+struct CornerAbruptPtttState : public PtttState<true> {
+  uint16_t opp_held[2] = {0, 0}; // cells held from the opening by p's opponent
+  bool masked = true;
+
+  CornerAbruptPtttState() : PtttState<true>() {
+    const PtttOpening &o = g_pttt_opening;
+    for (uint8_t k = 0; k < o.n; ++k) {
+      for (uint8_t q = 0; q < 2; ++q) {
+        this->x[q][o.cells[q][k]] = ((k + 1) << 1) + 1;
+        opp_held[q ^ 1] |= uint16_t(1u << o.cells[q][k]);
+      }
+    }
+    this->t[0] = o.n;
+    this->t[1] = o.n;
+    masked = o.masked;
+  }
+
+  uint32_t available_actions() const {
+    uint32_t ans = PtttState<true>::available_actions();
+    if (masked)
+      ans &= ~uint32_t(opp_held[this->player()]);
+    return ans;
+  }
+};
